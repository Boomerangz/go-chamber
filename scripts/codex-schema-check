#!/usr/bin/env bash
# Verifies that every app-server method and field the Codex adapter relies on
# still exists in the schema generated by the installed `codex`. Run after
# upgrading the Codex CLI (source of truth: `codex app-server
# generate-json-schema`, not the documentation).
set -euo pipefail

CODEX="${CODEX:-codex}"
out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT

"$CODEX" app-server generate-json-schema --out "$out" >/dev/null 2>&1

methods=(
  initialize
  initialized
  thread/start
  thread/resume
  thread/read
  thread/list
  turn/start
  turn/interrupt
  turn/steer
  item/commandExecution/requestApproval
  item/fileChange/requestApproval
  item/permissions/requestApproval
  item/tool/requestUserInput
  mcpServer/elicitation/request
  item/started
  item/completed
  item/agentMessage/delta
  item/reasoning/textDelta
  item/reasoning/summaryTextDelta
  item/commandExecution/outputDelta
  item/plan/delta
  item/fileChange/patchUpdated
  turn/started
  turn/completed
  turn/plan/updated
  serverRequest/resolved
)
fields=(
  threadId
  turnId
  itemId
  aggregatedOutput
  exitCode
  receiverThreadIds
  agentThreadId
  experimentalApi
  approvalsReviewer
  auto_review
)

fail=0
for m in "${methods[@]}"; do
  if ! grep -rqF "\"$m\"" "$out"; then
    echo "MISSING method: $m" >&2
    fail=1
  fi
done
for f in "${fields[@]}"; do
  if ! grep -rqF "\"$f\"" "$out"; then
    echo "MISSING field: $f" >&2
    fail=1
  fi
done

if [[ $fail -ne 0 ]]; then
  echo "codex schema drift detected for $("$CODEX" --version)" >&2
  exit 1
fi
echo "codex schema ok ($("$CODEX" --version))"
