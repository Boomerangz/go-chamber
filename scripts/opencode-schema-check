#!/usr/bin/env python3
"""Check consumed HTTP fields against the installed OpenCode /openapi.json.
Uses an authenticated throwaway loopback server. The v2 event stream is not
described there; recorded events in testdata cover it.
--schema FILE checks an already captured schema; --record writes the contract.
"""
import argparse, base64, json, os, pathlib, re, secrets, subprocess, urllib.request

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTRACT = ROOT / 'internal/adapters/opencode/testdata/schema-contract.json'
BASELINE = '2.0.15'
PATHS = [
 '/api/session:post', '/api/session:get', '/api/session/{sessionID}:get',
 '/api/session/{sessionID}/fork:post', '/api/session/{sessionID}/message:get',
 '/api/session/{sessionID}/prompt:post', '/api/session/{sessionID}/command:post',
 '/api/session/{sessionID}/model:post', '/api/session/{sessionID}/interrupt:post',
 '/api/session/active:get', '/api/model:get', '/api/model/default:get', '/api/command:get',
 '/api/permission/request:get', '/api/session/{sessionID}/permission/{requestID}/reply:post',
 '/api/form:get', '/api/session/{sessionID}/form/{formID}/reply:post',
 '/api/session/{sessionID}/form/{formID}:delete', '/api/event:get',
]
SCHEMAS = {
 'Session.Info':['id','parentID','title','cost','tokens','location'],
 'TokenUsage.Info':['input','output','reasoning','cache'],
 'Model.Ref':['id','providerID','variant'],
 'Model.Info':['id','providerID','name','enabled','capabilities','variants'],
 'Session.Message.User':['id','type','text'],
 'Session.Message.Assistant':['id','type','content','error'],
 'Session.Message.Assistant.Text':['type','text'],
 'Session.Message.Assistant.Reasoning':['type','text'],
 'Session.Message.Assistant.Tool':['type','id','name','state'],
 'Session.Message.ToolState.Completed':['status','input','content','metadata'],
 'Session.Message.ToolState.Error':['status','input','error','metadata'],
 'Session.StructuredError':['type','message'],
 'Permission.Request':['id','sessionID','action','resources','save','metadata'],
 'Form.Info':['id','sessionID','title','fields'],
 'Form.StringField':['key','type','title','description','hidden','options','custom'],
 'Form.MultiselectField':['key','type','title','description','hidden','options','custom'],
 'Form.Option':['value','label','description'],
}
def slim(v):
 if isinstance(v, list): return [slim(x) for x in v]
 if not isinstance(v, dict): return v
 out = {}
 for k, value in v.items():
  if k == 'properties':
   out[k] = {name: slim(prop) for name, prop in value.items()}
  elif k in ('type','$ref','enum','items','anyOf','oneOf','allOf','additionalProperties',
             'required','const','minLength','maxLength','minimum','maximum','pattern'):
   out[k] = slim(value)
 return out

def references(value):
 if isinstance(value, dict):
  if '$ref' in value: yield value['$ref'].rsplit('/', 1)[-1]
  for child in value.values(): yield from references(child)
 elif isinstance(value, list):
  for child in value: yield from references(child)

def consumed(schema):
 out={'paths':{},'schemas':{}}
 for key in PATHS:
  path,method=key.rsplit(':',1); op=schema['paths'][path][method]
  out['paths'][key]={'operationId':op['operationId'],
   'parameters':sorted(q['name'] for q in op.get('parameters',[])),
   'requestBody':slim(op.get('requestBody',{}).get('content',{}).get('application/json',{}).get('schema',{})),
   'response':slim(op.get('responses',{}).get('200',{}).get('content',{}).get('application/json',{}).get('schema',{}))}
 for name,fields in SCHEMAS.items():
  v=schema['components']['schemas'][name]['properties']
  out['schemas'][name]={f:slim(v[f]) for f in fields}
 pending=list(references(out))
 while pending:
  name=pending.pop()
  if name in out['schemas']: continue
  value=slim(schema['components']['schemas'][name])
  out['schemas'][name]=value
  pending.extend(references(value))
 return out
def main():
 parser=argparse.ArgumentParser();parser.add_argument('--schema');parser.add_argument('--record',action='store_true');args=parser.parse_args()
 if args.schema: schema=json.loads(pathlib.Path(args.schema).read_text())
 else:
  password=secrets.token_hex(24);env={**os.environ,'OPENCODE_SERVER_USERNAME':'opencode','OPENCODE_SERVER_PASSWORD':password}
  proc=subprocess.Popen([os.environ.get('OPENCODE','opencode'),'serve','--hostname','127.0.0.1','--port','0'],env=env,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL,text=True)
  try:
   # Startup stdout is finite; an outer 30-second watchdog also kills hung servers.
   import threading
   watchdog=threading.Timer(30,proc.kill);watchdog.start()
   for line in proc.stdout:
    match=re.search(r'http://127\.0\.0\.1:\d+',line)
    if match:break
   else:raise RuntimeError('OpenCode exited before listening')
   req=urllib.request.Request(match.group()+'/openapi.json',headers={'Authorization':'Basic '+base64.b64encode(('opencode:'+password).encode()).decode()})
   schema=json.load(urllib.request.urlopen(req,timeout=15))
  finally:
   watchdog.cancel();proc.terminate();proc.wait(timeout=10)
 actual=consumed(schema)
 if args.record: CONTRACT.parent.mkdir(exist_ok=True);CONTRACT.write_text(json.dumps(actual,indent=2,sort_keys=True)+'\n')
 else:
  expected=json.loads(CONTRACT.read_text())
  for section,entries in expected.items():
   for name,value in entries.items():
    if actual[section].get(name)!=value:raise SystemExit(f'OpenCode consumed schema changed: {section}/{name}. Review adapter and fixtures before --record.')
 print(f'OpenCode consumed HTTP schema matches (baseline {BASELINE}).')

if __name__ == "__main__":
 main()
