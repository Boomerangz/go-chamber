+package claude
+
+import (
+	"github.com/igorzygin/go-chamber/internal/domain"
+	"testing"
+)
+
+func TestAuditItemsDistinctAfterRuntimeRestart(t *testing.T) {
+	ids := []domain.ItemID{}
+	for _, line := range []string{
+		`{"type":"assistant","message":{"id":"msg-before","content":[{"type":"text","text":"first answer"}]}}`,
+		`{"type":"assistant","message":{"id":"msg-after","content":[{"type":"text","text":"second answer"}]}}`,
+	} {
+		events, err := NewMapper("same-session").Map([]byte(line))
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, ev := range events {
+			if ev.Item != nil {
+				ids = append(ids, ev.Item.ID)
+				break
+			}
+		}
+	}
+	if len(ids) != 2 {
+		t.Fatalf("unexpected ids %v", ids)
+	}
+	if ids[0] == ids[1] {
+		t.Fatalf("restart reuses item id %q; old answer will be overwritten", ids[0])
+	}
+}
