+package codex
+
+import (
+	"context"
+	"github.com/igorzygin/go-chamber/internal/app"
+	"github.com/igorzygin/go-chamber/internal/domain"
+	"testing"
+)
+
+func TestAuditConfigModeClearsFullAccess(t *testing.T) {
+	rt := startCodex(t, app.StartRequest{PermissionMode: "full-access"})
+	if got := askMode(t, rt); got != "mode: never dangerFullAccess" {
+		t.Fatalf("setup %q", got)
+	}
+	if err := rt.SetPermissionMode(context.Background(), ""); err != nil {
+		t.Fatal(err)
+	}
+	if got := askMode(t, rt); got == "mode: never dangerFullAccess" {
+		t.Fatalf("config mode kept full access: %s", got)
+	}
+}
+
+func TestAuditForkReplaysUserMessages(t *testing.T) {
+	m := NewMapper("fork")
+	events := m.MapThread(rpcThread{ID: "fork-native", Turns: []rpcTurn{{ID: "t", Items: []rpcItem{{ID: "user-1", Type: "userMessage"}}}}})
+	for _, ev := range events {
+		if ev.Item != nil && ev.Item.Kind == domain.ItemUserMessage {
+			return
+		}
+	}
+	t.Fatal("fork replay dropped user's message")
+}
