{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/lib/**/*.ts",
    "src/stores/**/*.ts",
    "!src/**/*.test.*"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  }
}
