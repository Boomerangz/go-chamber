      "css": ".ds-field{height:32px;padding:0 10px;border:1px solid var(--rule-strong,#a6a6a0);border-radius:2px;background:var(--paper,#f3f3f1);color:var(--ink,#16171a);font:14px -apple-system,BlinkMacSystemFont,system-ui,sans-serif;transition:border-color 120ms}.ds-field::placeholder{color:var(--ink-3,#66686e)}.ds-field:hover{border-color:var(--ink-3,#66686e)}.ds-field:focus{outline:none;border-color:var(--act,#2433d6);box-shadow:0 0 0 1px var(--act,#2433d6)}"
    },
