      "html": "<button class=\"ds-chip\">go-chamber</button>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 8px;border:1px solid var(--rule-strong,#a6a6a0);border-radius:2px;background:var(--paper,#f3f3f1);color:var(--ink-2,#45474d);font-family:'PT Mono',ui-monospace,monospace;font-size:12px;cursor:pointer}.ds-chip:hover{border-color:var(--ink,#16171a);color:var(--ink,#16171a)}.ds-chip:focus-visible{outline:2px solid var(--act-ring,rgba(36,51,214,.55));outline-offset:1px}"
    },
    {
      "name": "State Marks",
      "kind": "custom",
      "refersTo": "",
      "description": "State is form: solid running, hollow idle, struck interrupted, dashed detached. No hue.",
      "html": "<div class=\"ds-states\"><span class=\"ds-status ds-running\">running</span><span class=\"ds-status\">idle</span><span class=\"ds-status ds-interrupted\">interrupted</span><span class=\"ds-status ds-detached\">detached</span></div>",
      "css": ".ds-states{display:flex;gap:16px}.ds-status{display:inline-flex;align-items:center;gap:6px;font-family:'PT Mono',ui-monospace,monospace;font-size:12px;color:var(--ink-2,#45474d);text-transform:lowercase}.ds-status::before{content:'';width:8px;height:8px;border:1px solid currentColor;border-radius:1px}.ds-running{color:var(--ink,#16171a)}.ds-running::before{background:currentColor}.ds-interrupted{color:var(--ink,#16171a)}.ds-interrupted::before{background:linear-gradient(to top right,transparent 45%,currentColor 45% 60%,transparent 60%)}.ds-detached{color:var(--ink-3,#66686e)}.ds-detached::before{border-style:dashed}"
    },
    {
      "name": "Session Row",
      "kind": "nav",
      "refersTo": "session-row-active",
      "description": "TOC row as a label grid: agent box, title over state and age, amber request count.",
      "html": "<button class=\"ds-session ds-active\"><span class=\"ds-avatar\">C</span><span class=\"ds-stext\"><span class=\"ds-stitle\">hello — привет</span><span class=\"ds-smeta\"><span class=\"ds-smark\">running</span><span>just now</span></span></span><span class=\"ds-count\">1</span></button>",
      "css": ".ds-session{width:280px;display:grid;grid-template-columns:auto minmax(0,1fr) 18px;column-gap:9px;align-items:center;padding:6px 8px;border:1px solid transparent;border-radius:2px;background:none;text-align:left;color:inherit;cursor:pointer;transition:background 120ms}.ds-session:hover{background:var(--paper-2,#e9e9e5)}.ds-active{background:var(--paper-2,#e9e9e5);border-color:var(--rule-strong,#a6a6a0)}.ds-session:focus-visible{outline:2px solid var(--act-ring,rgba(36,51,214,.55));outline-offset:1px}.ds-avatar{display:grid;place-items:center;width:22px;height:22px;border:1px solid var(--rule-strong,#a6a6a0);border-radius:2px;font-family:'PT Mono',monospace;font-size:12px;background:var(--paper,#f3f3f1)}.ds-stext{display:grid;gap:1px;min-width:0}.ds-stitle{font:500 13px -apple-system,system-ui,sans-serif;color:var(--ink,#16171a);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-smeta{display:flex;justify-content:space-between;font-family:'PT Mono',monospace;font-size:11.5px;color:var(--ink-3,#66686e)}.ds-smark{display:inline-flex;align-items:center;gap:5px;color:var(--ink,#16171a)}.ds-smark::before{content:'';width:7px;height:7px;background:currentColor;border-radius:1px}.ds-count{display:inline-grid;place-items:center;min-width:18px;height:18px;padding:0 4px;border-radius:2px;background:var(--req-mark,#b86a00);color:var(--paper,#f3f3f1);font-family:'PT Mono',monospace;font-size:11px}"
    },
    {
      "name": "REQUIRES Block",
      "kind": "custom",
      "refersTo": "requires-block",
      "description": "The signature: the only amber on screen, directly above the composer.",
      "html": "<div class=\"ds-req\"><div class=\"ds-req-title\"><span class=\"ds-req-kw\">Requires approval</span>Run command</div><p class=\"ds-req-prompt\">Claude wants to run: make test</p><span class=\"ds-req-tool\">Bash</span><pre class=\"ds-req-input\">{ \"command\": \"make test\" }</pre><div class=\"ds-req-actions\"><button class=\"ds-rb ds-rb-primary\">Allow</button><button class=\"ds-rb\">Allow for session</button><button class=\"ds-rb ds-rb-danger\">Deny</button></div></div>",
      "css": ".ds-req{position:relative;display:grid;gap:8px;max-width:560px;padding:12px 14px 14px;border:1px solid var(--req-mark,#b86a00);border-radius:2px;background:var(--paper,#f3f3f1);color:var(--ink,#16171a);font:14px/1.5 -apple-system,system-ui,sans-serif}.ds-req::before{content:'';position:absolute;left:-1px;right:-1px;top:-1px;height:3px;background:var(--req-mark,#b86a00)}.ds-req-title{display:flex;align-items:baseline;gap:10px;font-size:18px;font-weight:600}.ds-req-kw{font-family:'PT Mono',monospace;font-size:13px;font-weight:400;letter-spacing:.06em;text-transform:uppercase;color:var(--req,#8f5200)}.ds-req-prompt{margin:0;color:var(--ink-2,#45474d)}.ds-req-tool{font-family:'PT Mono',monospace;font-size:12px}.ds-req-tool::before{content:'tool: ';color:var(--ink-3,#66686e)}.ds-req-input{margin:0;padding:8px 12px;background:var(--paper-2,#e9e9e5);border-left:1px solid var(--rule-strong,#a6a6a0);color:var(--ink-2,#45474d);font:12px 'PT Mono',monospace}.ds-req-actions{display:flex;gap:8px;margin-top:4px}.ds-rb{height:30px;padding:0 12px;border:1px solid var(--rule-strong,#a6a6a0);border-radius:2px;background:var(--paper,#f3f3f1);color:var(--ink,#16171a);font:12px 'PT Mono',monospace;cursor:pointer}.ds-rb:hover{border-color:var(--ink,#16171a)}.ds-rb:focus-visible{outline:2px solid var(--act-ring,rgba(36,51,214,.55));outline-offset:1px}.ds-rb-primary{background:var(--act,#2433d6);border-color:var(--act,#2433d6);color:var(--act-ink,#fff)}.ds-rb-danger{background:transparent;border-color:var(--bad,#b3261e);color:var(--bad,#b3261e)}.ds-rb-danger:hover{background:var(--bad-wash,rgba(179,38,30,.08));border-color:var(--bad,#b3261e)}"
    },
