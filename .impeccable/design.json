      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:30px;padding:0 12px;border:1px solid var(--rule-strong,#a6a6a0);border-radius:2px;background:var(--paper,#f3f3f1);color:var(--ink,#16171a);font-family:'PT Mono',ui-monospace,'SF Mono',Menlo,monospace;font-size:12px;font-weight:400;cursor:pointer;transition:background 120ms,border-color 120ms,color 120ms}.ds-btn:hover{border-color:var(--ink,#16171a)}.ds-btn:active{background:var(--paper-2,#e9e9e5)}.ds-btn:focus-visible{outline:2px solid var(--act-ring,rgba(36,51,214,.55));outline-offset:1px}"
